BOT_TOKEN=токен_от_botfather
# Локально — адрес туннеля (его сам пропишет start.sh). На Railway — постоянный
# публичный домен сервиса (railway domain), задаётся один раз вручную.
APP_URL=https://your-tunnel-url.loca.lt
PORT=3000
# Необязательно: если не заданы, бот сам залогирует id/username первого
# написавшего в консоль строкой [contact] — их и впишите сюда.
ADMIN_USERNAME=
ADMIN_CHAT_ID=
# Authorization key из личного кабинета GigaChat API (Base64-строка, выдаётся
# при создании проекта на developers.sber.ru).
GIGACHAT_AUTH_KEY=
# Тариф физлица-разработчика — оставьте как есть, если не подключали юрлицо.
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Опционально: имя модели, если Сбер переименует тариф (по умолчанию GigaChat).
GIGACHAT_MODEL=GigaChat
# Опционально: путь до российского корневого сертификата (Russian Trusted Root CA),
# если не задан — проверка TLS для хостов GigaChat отключается автоматически.
GIGACHAT_CA_CERT_PATH=
# Сколько генераций в день разрешено одному пользователю (защита бесплатной квоты).
DAILY_GENERATE_LIMIT=15

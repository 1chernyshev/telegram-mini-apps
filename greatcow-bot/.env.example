# Токен бота от @BotFather
BOT_TOKEN=

# Публичный URL приложения (Railway-домен в проде, туннель — в локальной разработке)
APP_URL=https://great-cow-vch-bot-production.up.railway.app

# Кому падают уведомления о новых заказах и отзывах (chat_id администратора)
ADMIN_CHAT_ID=
ADMIN_USERNAME=

# Порт локального сервера (Railway подставляет свой PORT автоматически)
PORT=3000

# ТОЛЬКО для локальной разработки: позволяет открыть Mini App в обычном
# браузере (без Telegram) и оформить тестовый заказ без реального initData.
# На Railway эту переменную не задаём.
DEV_USER_ID=
